DATABASE_URL=postgresql+psycopg://cloudmentor:cloudmentor@localhost:5432/cloudmentor
GEMINI_API_KEY=replace_with_your_key
MODEL_NAME=gemini-2.5-flash

CLOUDMENTOR_SOURCE_STORAGE=local
CLOUDMENTOR_UPLOAD_DIR=storage/uploads

CLOUDMENTOR_MINIO_ENDPOINT=localhost:9000
CLOUDMENTOR_MINIO_ACCESS_KEY=replace_with_minio_access_key
CLOUDMENTOR_MINIO_SECRET_KEY=replace_with_minio_secret_key
CLOUDMENTOR_MINIO_BUCKET=cloudmentor-sources
CLOUDMENTOR_MINIO_SECURE=false
