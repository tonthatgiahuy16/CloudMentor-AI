# Keep POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB consistent with DATABASE_URL.
DATABASE_URL=postgresql+psycopg://cloudmentor:replace_with_postgres_password@localhost:5432/cloudmentor
POSTGRES_USER=cloudmentor
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=cloudmentor
GEMINI_API_KEY=replace_with_your_key
MODEL_NAME=gemini-2.5-flash
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1

# Authentication. Set a long random secret (32+ bytes) in every environment.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Retrieval. The Chroma collection is pinned to cosine space.
MIN_COSINE_SIMILARITY=0.50

# Observability. Logs are JSON by default; use "human" only for local debugging.
LOG_FORMAT=json

CLOUDMENTOR_SOURCE_STORAGE=local
CLOUDMENTOR_UPLOAD_DIR=storage/uploads
CHROMA_DIR=chroma_db

# Public demo controls. Set the exact static-site origin in production.
DEMO_MODE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
CHAT_RATE_LIMIT_PER_MINUTE=12
DEMO_SEED_TOKEN=replace_with_a_long_random_secret
DEMO_SEED_DIR=demo-sources

CLOUDMENTOR_MINIO_ENDPOINT=localhost:9000
CLOUDMENTOR_MINIO_ACCESS_KEY=replace_with_minio_access_key
CLOUDMENTOR_MINIO_SECRET_KEY=replace_with_minio_secret_key
CLOUDMENTOR_MINIO_BUCKET=cloudmentor-sources
CLOUDMENTOR_MINIO_SECURE=false
